    { who = "pret/pokered", for_ = "the tile and sprite data the geometry is derived from" },
    { who = "AverageConsumer", for_ = "battle UI/sprite interoperability (honouring the engine's visibility seams and composing staged-battle sprite overrides) and the cold mesh-build Town Map loading cover" },
  },
  compat = { engine = ">=0.1.37 <1.6.1", modApi = 2 },
}
